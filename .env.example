NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/elikia
# Optionnel : resolveurs DNS utilises par Node pour MongoDB Atlas (querySrv EREFUSED)
DNS_SERVERS=8.8.8.8,1.1.1.1

CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=remplace_par_une_longue_valeur_aleatoire
JWT_REFRESH_SECRET=remplace_par_une_autre_longue_valeur
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Partie B (laisser vide pour l'instant)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Elikia <no-reply@elikia.com>

# Brevo (API v3) - recommande pour un envoi reel en developpement.
# La cle se trouve dans Brevo > SMTP & API > API Keys.
# MAIL_FROM doit utiliser un expediteur verifie dans Brevo.
BREVO_API_KEY=

# Mot de passe des comptes de test créés par le seed (développement uniquement)
SEED_PASSWORD=Elikia@2026!